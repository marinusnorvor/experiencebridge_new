# Placeholder-only production profile; never store actual credentials in this tracked file.
# Public values are embedded at build time. Build separately for each API origin.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Production mode never enables the unauthenticated presentation path.
NEXT_PUBLIC_PORTAL_PREVIEW=false

# Server-only same-origin proxy target
API_UPSTREAM_ORIGIN=http://127.0.0.1:8000
API_UPSTREAM_ALLOWED_HOST=127.0.0.1
# Shared server-only secret, required in staging/production
AUTH_PROXY_SECRET=<replace-with-same-random-32-byte-secret>
