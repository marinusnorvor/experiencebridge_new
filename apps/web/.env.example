# Placeholder-only production profile; never store actual credentials in this tracked file.
# Public values are embedded at build time. Build separately for each API origin.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_<production-publishable-key>
CLERK_SECRET_KEY=sk_live_<production-secret-key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Production mode never enables the unauthenticated presentation path.
NEXT_PUBLIC_PORTAL_PREVIEW=false
