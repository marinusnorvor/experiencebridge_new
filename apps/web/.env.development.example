# Local development only. Copy to .env.local in apps/web.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_PORTAL_PREVIEW=false
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only same-origin proxy target
API_UPSTREAM_ORIGIN=http://127.0.0.1:8000
API_UPSTREAM_ALLOWED_HOST=127.0.0.1
# Shared server-only secret, required in staging/production
AUTH_PROXY_SECRET=<replace-with-same-random-32-byte-secret>
# Development-only mail sink secret (matches apps/api AUTH_DEV_MAILBOX_SECRET)
AUTH_DEV_MAILBOX_SECRET=<replace-with-same-random-32-byte-secret>
