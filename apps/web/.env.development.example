# Local development only. Copy to .env.local in apps/web.
# NEXT_PUBLIC_* values are public and embedded at build time. Never prefix CLERK_SECRET_KEY with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_PORTAL_PREVIEW=false
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<replace_with_clerk_dev_publishable_key>
CLERK_SECRET_KEY=sk_test_<replace_with_clerk_dev_secret_key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
