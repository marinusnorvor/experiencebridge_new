NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_PORTAL_PREVIEW=false
NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com

# Server-only same-origin proxy target
API_UPSTREAM_ORIGIN=https://api-staging.example.invalid
API_UPSTREAM_ALLOWED_HOST=api-staging.example.invalid
# Shared server-only secret, required in staging/production
AUTH_PROXY_SECRET=<replace-with-same-random-32-byte-secret>
