# Configure in the staging deployment's secret environment; do not use for local development.
APP_ENV=staging
NEON_BRANCH=staging
DATABASE_URL=postgresql://experiencebridge_staging:<password>@<staging-pooler-host>/<database>?sslmode=require
# Direct (unpooled) connection used only by reviewed staging migration workflows:
# DATABASE_URL_UNPOOLED=postgresql://experiencebridge_staging:<password>@<staging-direct-host>/<database>?sslmode=require
CORS_ALLOWED_ORIGINS=https://staging-web.example.com
LOG_LEVEL=INFO

# Clerk authentication (Staging environment)
CLERK_ISSUER_URL=https://<your-clerk-staging-domain>.clerk.accounts.dev
# CLERK_JWKS_URL=https://<your-clerk-staging-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=pk_test_<replace_with_clerk_staging_publishable_key>
CLERK_SECRET_KEY=sk_test_<replace_with_clerk_staging_secret_key>
CLERK_AUTHORIZED_PARTIES=https://staging-web.example.com
# CLERK_AUDIENCE=
