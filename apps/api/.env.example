# Placeholder-only production profile. Never put real values in this tracked file.
# Configure these names in Vercel Production or an explicitly selected ignored local file.
# Local production-mode operation uses these same settings, NOT run_dev.py.
APP_ENV=production
NEON_BRANCH=production
DATABASE_URL=postgresql://<production-role>:<password>@<production-pooler-host>/<database>?sslmode=require
# Direct connection is used only for explicitly approved migrations.
# DATABASE_URL_UNPOOLED=<neon-direct-connection>
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_LEVEL=INFO
# Add a local HTTPS production-domain origin only after explicit trust approval.
# Do not include localhost, wildcard domains, or preview deployments in production trust lists.

# FastAPI authentication (replace placeholders; never commit real credentials)
FRONTEND_URL=http://localhost:3000
AUTH_IDENTITY_ISSUER=https://identity.example.invalid
AUTH_RATE_LIMIT_SECRET=<replace-with-32-or-more-random-bytes>
EMAIL_API_KEY=<server-only-provider-key>
EMAIL_FROM=<verified-sender@example.invalid>
# Shared server-only secret, required in staging/production
AUTH_PROXY_SECRET=<replace-with-same-random-32-byte-secret>
# Optional per-IP auth limits for testers sharing one network (defaults 30 / 20). Per-email limits never change.
# AUTH_LOGIN_PER_IP_PER_15MIN=300
# AUTH_REGISTER_PER_IP_PER_HOUR=300
