# Local development only. Copy to .env.development.local and use the Neon development branch.
APP_ENV=development
NEON_BRANCH=development
DATABASE_URL=postgresql://experiencebridge_development:<password>@<development-pooler-host>/<database>?sslmode=require
# Optional direct (unpooled) connection for explicit Alembic schema migrations only:
# DATABASE_URL_UNPOOLED=postgresql://experiencebridge_development:<password>@<development-direct-host>/<database>?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO


# FastAPI authentication (replace placeholders; never commit real credentials)
FRONTEND_URL=http://localhost:3000
AUTH_IDENTITY_ISSUER=https://identity.example.invalid
AUTH_RATE_LIMIT_SECRET=<replace-with-32-or-more-random-bytes>
# EMAIL_API_KEY=<server-only-provider-key>
# EMAIL_FROM=<verified-sender@example.invalid>
# Development-only mail sink (never enable on deployments)
AUTH_DEV_MAILBOX_ENABLED=true
AUTH_DEV_MAILBOX_SECRET=<replace-with-32-or-more-random-bytes>
# Shared server-only secret, required in staging/production
AUTH_PROXY_SECRET=<replace-with-same-random-32-byte-secret>

# Super Administrator credentials (optional; bootstrapped on startup if set)
SUPER_ADMIN_EMAIL=superadmin@experiencebridge.org
SUPER_ADMIN_PASSWORD=SuperAdminSecurePass123!
SUPER_ADMIN_NAME=Super Administrator
