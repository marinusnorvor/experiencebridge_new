# Local development only. Copy to .env.development.local and use the Neon development branch.
APP_ENV=development
NEON_BRANCH=development
DATABASE_URL=postgresql://experiencebridge_development:<password>@<development-pooler-host>/<database>?sslmode=require
# Optional direct (unpooled) connection for explicit Alembic schema migrations only:
# DATABASE_URL_UNPOOLED=postgresql://experiencebridge_development:<password>@<development-direct-host>/<database>?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Clerk authentication (Development application: app_3LEpoE8O013ojsnjd0xb5GkNWOJ)
CLERK_ISSUER_URL=https://<your-clerk-dev-domain>.clerk.accounts.dev
# CLERK_JWKS_URL=https://<your-clerk-dev-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=pk_test_<replace_with_clerk_dev_publishable_key>
CLERK_SECRET_KEY=sk_test_<replace_with_clerk_dev_secret_key>
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
# CLERK_AUDIENCE=
