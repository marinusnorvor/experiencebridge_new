# Configure only in the production deployment's secret environment. Never store real credentials here.
APP_ENV=production
NEON_BRANCH=production
DATABASE_URL=postgresql://<production-role>:<password>@<production-pooler-host>/<database>?sslmode=require
# Direct (unpooled) connection used only by explicitly authorized production migration workflows:
# DATABASE_URL_UNPOOLED=postgresql://<production-role>:<password>@<production-direct-host>/<database>?sslmode=require
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_LEVEL=INFO
