# Configure only in the production deployment's secret environment. Never store real credentials here.
APP_ENV=production
NEON_BRANCH=production
DATABASE_URL=postgresql://<production-role>:<password>@<production-pooler-host>/<database>?sslmode=require
# Direct (unpooled) connection used only by explicitly authorized production migration workflows:
# DATABASE_URL_UNPOOLED=postgresql://<production-role>:<password>@<production-direct-host>/<database>?sslmode=require
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_LEVEL=INFO

# Clerk authentication (Production environment — live keys required)
CLERK_ISSUER_URL=https://clerk.example.com
# CLERK_JWKS_URL=https://clerk.example.com/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=pk_live_<replace_with_clerk_production_publishable_key>
CLERK_SECRET_KEY=sk_live_<replace_with_clerk_production_secret_key>
CLERK_AUTHORIZED_PARTIES=https://app.example.com
# CLERK_AUDIENCE=
